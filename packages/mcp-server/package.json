{
  "name": "@osb/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing an Obsidian vault as an AI memory graph over stdio.",
  "type": "module",
  "bin": {
    "osb-mcp": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
